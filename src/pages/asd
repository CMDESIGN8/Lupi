  background: var(--world-gold);

  font: 900 9px/1 "Barlow", sans-serif;
  font-style: normal;
}

.gh-world__hint {
  position: absolute;
  right: 28px;
  bottom: 28px;

  z-index: 7;

  width: min(280px, 22vw);

  display: flex;
  align-items: flex-start;
  gap: 8px;

  color: rgba(226, 247, 236, 0.52);
}

.gh-world__hint span {
  color: var(--world-green);
  font: 900 8px/1 "Barlow", sans-serif;
  letter-spacing: 0.13em;
}

.gh-world__hint p { margin: 0; font: 500 9px/1.25 "Barlow", sans-serif; }


