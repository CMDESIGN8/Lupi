/* =========================================================
   WORLD EVENTS
   ========================================================= */

.gh-world-event {
  position: absolute;
  top: 76px;
  left: 50%;
  z-index: 40;

  display: flex;
  align-items: center;
  gap: 10px;

  min-width: 260px;
  max-width: min(420px, calc(100vw - 32px));

  padding: 10px 14px;

  transform: translateX(-50%);

  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 12px;

  background: linear-gradient(135deg, rgba(8, 12, 15, 0.92), rgba(8, 12, 15, 0.76));
  backdrop-filter: blur(14px);

  box-shadow:
    0 14px 40px rgba(0, 0, 0, 0.35),
    0 0 24px rgba(36, 233, 135, 0.08);

  animation:
    world-event-in 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) both,
    world-event-out 0.4s ease 3s forwards;

  pointer-events: none;
}

.gh-world-event__icon {
  display: grid;
  place-items: center;

  width: 34px;
  height: 34px;
  flex: 0 0 34px;

  border-radius: 10px;
  background: rgba(255, 255, 255, 0.05);

  font-size: 16px;
}

.gh-world-event__content {
  min-width: 0;

  display: flex;
  flex-direction: column;
  gap: 2px;
}

.gh-world-event__label {
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 1.8px;
  color: var(--world-green);
}

.gh-world-event__content strong {
  overflow: hidden;

  color: rgba(255, 255, 255, 0.92);

  font-size: 12px;
  font-weight: 600;
  line-height: 1.35;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.gh-world-event--player_join {
  box-shadow:
    0 14px 40px rgba(0, 0, 0, 0.35),
    0 0 28px rgba(36, 233, 135, 0.12);
}

.gh-world-event--player_leave { opacity: 0.9; }

.gh-world-event--level_up {
  box-shadow:
    0 14px 40px rgba(0, 0, 0, 0.35),
    0 0 30px rgba(176, 97, 255, 0.18);
}

.gh-world-event--level_up .gh-world-event__label { color: #b061ff; }
.gh-world-event--aura_spotted .gh-world-event__label { color: #ff2bd6; }

@keyframes world-event-in {
  from { opacity: 0; transform: translateX(-50%) translateY(-12px) scale(0.96); }
  to   { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
}

@keyframes world-event-out {
  from { opacity: 1; }
  to   { opacity: 0; }
}

@media (max-width: 700px) {
  .gh-world-event {
    top: 64px;
    min-width: 0;
    width: calc(100vw - 32px);
  }
}

.gh-world-event--aura_spotted {
  border-color: var(--event-aura-medium);
  box-shadow:
    0 14px 40px rgba(0, 0, 0, 0.35),
    0 0 32px var(--event-aura-soft);
}

.gh-world-event--aura_spotted .gh-world-event__icon {
  color: var(--event-aura);
  background: var(--event-aura-soft);
  box-shadow:
    inset 0 0 0 1px var(--event-aura-medium),
    0 0 18px var(--event-aura-soft);

  animation: aura-event-pulse 1.4s ease-in-out infinite;
}

.gh-world-event--aura_spotted .gh-world-event__label { color: var(--event-aura); }

@keyframes aura-event-pulse {
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.08); }
}


/* =========================================================
   WORLD PROFILE MODAL
   ========================================================= */

.gh-world-profile-backdrop {
  position: absolute;
  inset: 0;
  z-index: 80;

  display: grid;
  place-items: center;

  padding: 24px;

  background: rgba(0, 0, 0, 0.42);
  backdrop-filter: blur(8px);

  animation: world-profile-backdrop-in 0.2s ease both;
}

.gh-world-profile {
  position: relative;

  width: min(360px, calc(100vw - 32px));

  overflow: hidden;
  padding: 28px 24px 22px;

  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 22px;

  background: linear-gradient(145deg, rgba(12, 17, 19, 0.98), rgba(7, 10, 12, 0.96));

  box-shadow:
    0 30px 90px rgba(0, 0, 0, 0.60),
    0 0 60px var(--profile-aura-soft);

  animation: world-profile-in 0.28s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.gh-world-profile__close {
  position: absolute;
  top: 12px; right: 12px;
  z-index: 5;

  width: 32px; height: 32px;

  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;

  background: rgba(255, 255, 255, 0.04);
  color: rgba(255, 255, 255, 0.70);

  font-size: 22px;
  line-height: 1;
  cursor: pointer;
}

.gh-world-profile__close:hover {
  background: rgba(255, 255, 255, 0.08);
  color: white;
}

.gh-world-profile__aura {
  position: absolute;
  top: -100px; left: 50%;

  width: 240px; height: 240px;

  transform: translateX(-50%);
  border-radius: 50%;

  background: radial-gradient(circle, var(--profile-aura-soft) 0%, transparent 68%);
  filter: blur(14px);
  pointer-events: none;
}

.gh-world-profile__avatar {
  position: relative;
  display: grid;
  place-items: center;

  width: 125px; height: 145px;

  margin: 4px auto 8px;

  filter:
    drop-shadow(0 0 18px var(--profile-aura-medium))
    drop-shadow(0 20px 14px rgba(0, 0, 0, 0.45));
}

.gh-world-profile__avatar img {
  max-width: 100%;
  max-height: 100%;

  object-fit: contain;

  position: relative;
  z-index: 2;
}

.gh-world-profile__avatar > span:not(.gh-world-profile__level) { font-size: 60px; }

.gh-world-profile__level {
  position: absolute;
  right: 4px; bottom: 4px;
  z-index: 4;

  display: grid;
  place-items: center;

  min-width: 30px; height: 30px;

  padding: 0 7px;

  border: 2px solid rgba(255, 255, 255, 0.85);
  border-radius: 10px;

  background: #090d0e;
  color: white;

  font-size: 12px;
  font-weight: 900;

  box-shadow: 0 0 16px var(--profile-aura-medium);
}

.gh-world-profile__identity { text-align: center; }

.gh-world-profile__eyebrow {
  display: block;
  margin-bottom: 4px;

  color: var(--profile-aura);

  font-size: 8px;
  font-weight: 900;
  letter-spacing: 1.8px;
}

.gh-world-profile__identity h2 {
  margin: 0;
  color: white;
  font-size: 24px;
  font-weight: 900;
}

.gh-world-profile__online {
  display: inline-flex;
  align-items: center;
  gap: 6px;

  margin-top: 7px;

  color: rgba(255, 255, 255, 0.48);

  font-size: 8px;
  font-weight: 800;
  letter-spacing: 1.3px;
}

.gh-world-profile__online i {
  width: 5px; height: 5px;
  border-radius: 50%;
  background: var(--profile-aura);
  box-shadow: 0 0 8px var(--profile-aura);
}

.gh-world-profile__stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);

  margin-top: 22px;

  border-top: 1px solid rgba(255, 255, 255, 0.07);
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}

.gh-world-profile__stats > div {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;

  padding: 13px 6px;
}

.gh-world-profile__stats > div + div {
  border-left: 1px solid rgba(255, 255, 255, 0.07);
}

.gh-world-profile__stats small {
  color: rgba(255, 255, 255, 0.34);
  font-size: 7px;
  font-weight: 900;
  letter-spacing: 1.3px;
}

.gh-world-profile__stats strong {
  color: rgba(255, 255, 255, 0.88);
  font-size: 12px;
  font-weight: 900;
}

.gh-world-profile__skin {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;

  margin-top: 16px;
  padding: 12px;

  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 12px;

  background: rgba(255, 255, 255, 0.025);
}

.gh-world-profile__skin > div {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.gh-world-profile__skin span:first-child {
  color: rgba(255, 255, 255, 0.32);
  font-size: 7px;
  font-weight: 900;
  letter-spacing: 1.2px;
}

.gh-world-profile__skin strong {
  overflow: hidden;
  color: rgba(255, 255, 255, 0.88);
  font-size: 11px;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gh-world-profile__rarity {
  flex: 0 0 auto;
  padding: 5px 7px;
  border: 1px solid;
  border-radius: 7px;
  font-size: 7px;
  font-weight: 900;
  letter-spacing: 0.8px;
}

.gh-world-profile__actions {
  display: grid;
  gap: 8px;
  margin-top: 16px;
}

.gh-world-profile__action {
  width: 100%;
  min-height: 42px;

  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 11px;

  background: rgba(255, 255, 255, 0.04);
  color: rgba(255, 255, 255, 0.72);

  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.8px;

  cursor: pointer;
}

.gh-world-profile__action:hover {
  background: rgba(255, 255, 255, 0.08);
  color: white;
}

.gh-world-profile__action--primary {
  border-color: var(--profile-aura-medium);
  background: var(--profile-aura-soft);
  color: var(--profile-aura);
  box-shadow: 0 0 22px var(--profile-aura-soft);
}

@keyframes world-profile-backdrop-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes world-profile-in {
  from { opacity: 0; transform: translateY(14px) scale(0.96); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}


