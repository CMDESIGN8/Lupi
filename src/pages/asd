/* =========================================================
   PLAY BUTTON + ACTIONS
   ========================================================= */

.gh-world__play {
  position: absolute;

  left: 50%;
  bottom: 90px;

  z-index: 120 !important;

  display: flex;
  align-items: center;

  gap: 12px;

  min-width: 290px;

  padding: 14px 17px;

  transform: translateX(-50%);

  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 9px 3px 9px 3px;

  cursor: pointer;

  color: #08130e;
  background: linear-gradient(135deg, #ffd000, #ff9100);
  text-align: left;

  box-shadow:
    0 18px 45px rgba(255, 145, 0, 0.38),
    0 0 0 1px rgba(255, 208, 0, 0.22),
    0 0 35px rgba(255, 170, 0, 0.12);

  transition:
    transform 0.18s ease,
    filter 0.18s ease,
    box-shadow 0.18s ease;

  pointer-events: auto !important;
}

.gh-world__play:hover {
  transform: translateX(-50%) translateY(-3px);
  filter: brightness(1.08);
  box-shadow:
    0 20px 45px rgba(255, 145, 0, 0.5),
    0 0 28px rgba(255, 208, 0, 0.3);
}

.gh-world__play-icon {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 7px 2px 7px 2px;
  background: rgba(0, 0, 0, 0.15);
  font-size: 18px;
}

.gh-world__play span:nth-child(2) {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.gh-world__play small {
  font: 900 8px/1 "Barlow", sans-serif;
  letter-spacing: 0.12em;
  opacity: 0.62;
}

.gh-world__play strong {
  margin-top: 3px;
  font: italic 900 22px/0.9 "Barlow Condensed", sans-serif;
  letter-spacing: 0.03em;
}

.gh-world__play-arrow { font-size: 24px; font-weight: 900; }

.gh-world__actions {
  position: absolute;

  left: 50%;
  bottom: 155px;

  z-index: 120 !important;

  display: flex;
  flex-wrap: nowrap;
  align-items: center;

  gap: 7px;

  transform: translateX(-50%);
  pointer-events: auto !important;
}

.gh-world__actions button {
  position: relative;

  z-index: 121;

  min-width: 70px;
  padding: 8px 11px;

  border: 1px solid rgba(255, 255, 255, 0.11);
  border-radius: 9px 3px 9px 3px;

  color: #dff8ea;
  background: rgba(4, 22, 17, 0.65);

  backdrop-filter: blur(8px);
  cursor: pointer;

  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  transition: 0.18s ease;
  pointer-events: auto !important;
}

.gh-world__actions button:hover {
  transform: translateY(-2px);
  border-color: rgba(36, 233, 135, 0.35);
  background: rgba(10, 50, 39, 0.75);
}

.gh-world__actions span { display: block; font-size: 16px; line-height: 1; }

.gh-world__actions strong {
  display: block;
  margin-top: 5px;
  font: 900 8px/1 "Barlow", sans-serif;
  letter-spacing: 0.1em;
}

.gh-world__actions em {
  position: absolute;

  top: -6px;
  right: -5px;

  display: grid;
  place-items: center;

