  .gh-world__mission-kicker { font-size: 7px; }
  .gh-world__mission strong { font-size: 18px; margin-top: 3px; }
  .gh-world__mission span:last-child { font-size: 9px; margin-top: 4px; }

  /* AVATAR */
  .gh-locker-zone {
    position: absolute;

    left: 50%;
    top: 155px;
    bottom: 130px;

    width: 100vw;
    max-width: 100vw;

    height: auto;

    transform: translateX(-50%);

    z-index: 20;

    overflow: visible;
    pointer-events: none;

    display: block;
  }

  .gh-locker-zone .avatar2d {
    position: absolute;

    left: 50%;
    bottom: -30px;

    width: 390px;
    height: 520px;

    transform: translateX(-50%) scale(0.85);
    transform-origin: center bottom;

    margin: 0;
  }

  @media (min-width: 600px) and (max-width: 700px) {
    .gh-locker-zone .avatar2d { transform: translateX(-50%) scale(0.95); }
  }

  @media (min-width: 430px) and (max-width: 599px) {
    .gh-locker-zone .avatar2d {
      transform: translateX(-50%) scale(1.2);
      bottom: -290px;
    }
  }

  @media (min-width: 390px) and (max-width: 429px) {
    .gh-locker-zone .avatar2d {
      transform: translateX(-50%) scale(1.2);
      bottom: -200px;
    }
  }

  @media (min-width: 375px) and (max-width: 389px) {
    .gh-locker-zone .avatar2d { transform: translateX(-50%) scale(0.78); }
  }

  @media (max-width: 374px) {
    .gh-locker-zone .avatar2d { transform: translateX(-50%) scale(0.70); }
  }

  .gh-locker-zone .avatar2d__character {
    transform: translateX(-50%) scale(0.92);
    transform-origin: center bottom;
    top: 0;
    bottom: 0;
  }

  .gh-locker-zone .avatar2d__aura {
    width: 340px;
    height: 340px;
    bottom: 40px;
  }

  .gh-locker-zone .avatar2d__shadow { bottom: 6px; }

  /* SLOTS */
  .gh-locker-zone .locker-equipment {
    position: absolute;
    left: 0; top: 0;
    width: 100%; height: 100%;

    margin: 0;
    padding: 0 !important;

    transform: none;

    display: block !important;

    z-index: 70;
    pointer-events: none;

    grid-template-columns: none !important;
    gap: 0 !important;
  }

  .gh-locker-zone .locker-equipment .locker-slot {
    position: absolute;

    width: 68px;
    height: 68px;

    margin: 0;
    padding: 0;

    display: grid !important;
    place-items: center;

    pointer-events: auto;

    border-radius: 16px 6px 16px 6px;

    background: linear-gradient(135deg, rgba(10, 40, 32, 0.94), rgba(4, 20, 16, 0.94));
    border: 1.5px solid rgba(76, 210, 155, 0.5);

    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 6px 18px rgba(0, 0, 0, 0.55);

    color: #dff8ea;
    cursor: pointer;
    overflow: hidden;

    gap: 0 !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .gh-locker-zone .locker-equipment .locker-slot-info,
  .gh-locker-zone .locker-equipment .locker-slot-arrow {
    display: none !important;
  }

  .gh-locker-zone .locker-equipment .locker-slot-icon {
    width: 100% !important;
    height: 100% !important;

    flex: 0 0 auto !important;
    flex-basis: auto !important;

    display: grid !important;
    place-items: center;

    border-radius: 0;
    background: transparent !important;

    font-size: 32px !important;
    line-height: 1;
  }

  .gh-locker-zone .locker-equipment .locker-slot:nth-child(1) {
    left: 8px; top: 40%; transform: translateY(-50%);
    width: 65px; height: 75px;
  }

  .gh-locker-zone .locker-equipment .locker-slot:nth-child(2) {
    left: 8px; top: 62%; transform: translateY(-50%);
    width: 65px; height: 75px;
  }

  .gh-locker-zone .locker-equipment .locker-slot:nth-child(3) {
    right: 8px; left: auto; top: 62%; transform: translateY(-50%);
    width: 65px; height: 75px;
  }

  .gh-locker-zone .locker-equipment .locker-slot:nth-child(4) {
    right: 8px; left: auto; top: 40%; transform: translateY(-50%);
    width: 65px; height: 75px;
  }

  /* JUGADORES — ocultos, viven en el sheet */
  .gh-world__players { display: none !important; }

  /* TOGGLE JUGADORES */
  .gh-world__players-toggle {
    position: absolute;

    left: 10px;
    right: auto;
    bottom: 150px;

    z-index: 50;

    width: 54px;
    height: 54px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: 1px solid rgba(0, 255, 135, 0.42);
    border-radius: 50%;

    cursor: pointer;
    color: #ffffff;

    background:
      radial-gradient(circle at 35% 30%, rgba(0, 255, 135, 0.25), transparent 45%),
      rgba(3, 20, 16, 0.88);

    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.25),
      0 8px 25px rgba(0, 0, 0, 0.45),
      0 0 20px rgba(0, 255, 135, 0.16);

    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);

    pointer-events: auto;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .gh-world__players-toggle:active { transform: scale(0.92); }

  .gh-world__players-toggle > span {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: auto;
    height: auto;

    padding: 0;
    border: 0;
    border-radius: 0;

    background: transparent;
    box-shadow: none;

    color: #eafff3;

    font-size: 22px;
    line-height: 1;

    pointer-events: none;
    filter: drop-shadow(0 0 6px rgba(0, 255, 135, 0.35));
  }

  .gh-world__players-toggle em {
    position: absolute;

    top: -5px;
    right: -4px;

    min-width: 20px;
    height: 20px;

    padding: 0 5px;

    display: grid;
    place-items: center;

    border: 2px solid #06100d;
    border-radius: 999px;

    color: #06100d;
    background: #00ff87;

    font: 900 9px/1 "Barlow", sans-serif;
    font-style: normal;

    box-shadow: 0 0 12px rgba(0, 255, 135, 0.55);
    animation: lc-mobile-unread-pulse 1.8s ease-in-out infinite;
  }

  .gh-world__players-toggle::after {
    content: "ONLINE";

    position: absolute;

    bottom: -17px;
    left: 50%;

    transform: translateX(-50%);

    color: rgba(255, 255, 255, 0.5);
    font: 800 7px/1 "Barlow", sans-serif;
    letter-spacing: 0.12em;

    white-space: nowrap;
    pointer-events: none;
  }

  /* SHEET DE JUGADORES */
  .gh-world__players-sheet {
    position: absolute;
    inset: 0;

    z-index: 150;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(8px);

    animation: gh-sheet-backdrop-in 0.22s ease both;
  }

  .gh-world__players-sheet-panel {
    width: 100%;
    max-width: 420px;
    max-height: 80dvh;

    display: flex;
    flex-direction: column;

    padding: 20px 18px;
    border-radius: 20px;

    background: linear-gradient(180deg, rgba(8, 30, 25, 0.98), rgba(4, 18, 14, 0.98));
    border: 1px solid rgba(36, 233, 135, 0.25);

    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);

    animation: gh-sheet-in 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .gh-world__players-sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding-bottom: 12px;
    margin-bottom: 12px;

    border-bottom: 1px solid rgba(36, 233, 135, 0.15);
  }

  .gh-world__players-sheet-kicker {
    display: block;
    color: var(--world-green);
    font: 800 8px/1 "Barlow", sans-serif;
    letter-spacing: 0.2em;
  }

  .gh-world__players-sheet-head strong {
    display: block;
    margin-top: 4px;
    color: #fff;
    font: italic 900 20px/1 "Barlow Condensed", sans-serif;
    letter-spacing: 0.04em;
  }

  .gh-world__players-sheet-close {
    width: 36px; height: 36px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.75);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }

  .gh-world__players-sheet-list {
    flex: 1;
    min-height: 0;

    display: flex;
    flex-direction: column;
    gap: 8px;

    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .gh-world__players-sheet-item {
    display: flex;
    align-items: center;
    gap: 12px;

    width: 100%;
    padding: 10px 12px;

    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;

    background: rgba(255, 255, 255, 0.025);
    color: #fff;
    text-align: left;

    cursor: pointer;
    transition: background 0.18s ease, border-color 0.18s ease;
  }

  .gh-world__players-sheet-item:hover,
  .gh-world__players-sheet-item:active {
    background: rgba(36, 233, 135, 0.08);
    border-color: rgba(36, 233, 135, 0.35);
  }

  .gh-world__players-sheet-avatar {
    position: relative;
    width: 42px; height: 48px;
    flex: 0 0 42px;

    display: grid;
    place-items: center;

    filter: drop-shadow(0 0 8px var(--aura-color-medium));
  }

  .gh-world__players-sheet-avatar img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .gh-world__players-sheet-avatar > span {
    color: var(--aura-color);
    font-size: 26px;
  }

  .gh-world__players-sheet-level {
    position: absolute;
    right: -2px; bottom: -2px;

    min-width: 18px; height: 18px;
    padding: 0 4px;

    display: grid;
    place-items: center;

    border-radius: 5px 2px 5px 2px;

    background: var(--world-gold);
    color: #10160f;

    font: 900 9px/1 "Barlow", sans-serif;
    font-style: normal;
  }

  .gh-world__players-sheet-info {
    flex: 1;

    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .gh-world__players-sheet-info strong {
    overflow: hidden;
    color: #fff;
    font: 900 14px/1 "Barlow Condensed", sans-serif;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gh-world__players-sheet-info small {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: rgba(220, 255, 235, 0.55);
    font: 600 10px/1 "Barlow", sans-serif;
  }

  .gh-world__players-sheet-info small i {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--aura-color);
    box-shadow: 0 0 8px var(--aura-color);
  }

  .gh-world__players-sheet-arrow {
    color: rgba(255, 255, 255, 0.35);
    font-size: 18px;
    font-weight: 900;
  }

  .gh-world__players-sheet-empty {
    display: grid;
    place-items: center;
    padding: 40px 20px;
    text-align: center;
    color: rgba(255, 255, 255, 0.55);
  }

  .gh-world__players-sheet-empty span {
    display: grid;
    place-items: center;
    width: 54px; height: 54px;
    margin-bottom: 10px;
    border: 1px dashed rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    font-size: 24px;
  }

  .gh-world__players-sheet-empty strong {
    font: 900 14px/1 "Barlow Condensed", sans-serif;
    letter-spacing: 0.1em;
  }

  .gh-world__players-sheet-empty small {
    margin-top: 5px;
    font: 500 10px/1.3 "Barlow", sans-serif;
  }

  @keyframes gh-sheet-backdrop-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes gh-sheet-in {
    from { transform: scale(0.94) translateY(12px); opacity: 0; }
    to   { transform: scale(1) translateY(0); opacity: 1; }
  }

  /* BOTÓN JUGAR — mobile */
  .gh-world__play {
    left: 50%;
    bottom: 72px;

    width: 200px;
    min-width: 200px;
    height: 44px;

    z-index: 120 !important;

    transform: translateX(-50%);

    font-size: 11px;
    letter-spacing: 0.08em;

    padding: 8px 14px;
    gap: 8px;
  }

  .gh-world__play-icon { width: 28px; height: 28px; font-size: 15px; }
  .gh-world__play strong { font-size: 18px; }
  .gh-world__play small { font-size: 7px; }
  .gh-world__play-arrow { font-size: 18px; }

  /* OCULTAR CONTROLES DESKTOP */
  .gh-world__actions,
  .gh-world__hint { display: none; }

  /* MOBILE DOCK */
  .gh-world__dock {
    position: fixed !important;

    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    top: auto !important;

    width: 100vw !important;
    max-width: 100vw !important;
    min-width: 100vw !important;

    height: 58px !important;
    min-height: 58px !important;
    max-height: 58px !important;

    z-index: 9999 !important;

    display: grid !important;
    visibility: visible !important;

    grid-template-columns: repeat(5, 1fr) !important;

    margin: 0 !important;
    padding: 0 0 env(safe-area-inset-bottom, 0px) !important;

    background: linear-gradient(180deg, rgba(3, 10, 9, 0.92), rgba(2, 6, 6, 0.98)) !important;
    border: 0 !important;
    border-top: 1px solid rgba(36, 233, 135, 0.15) !important;
    border-radius: 0 !important;

    overflow: visible !important;
    transform: none !important;

    pointer-events: auto !important;
  }

  .gh-world__dock button {
    min-width: 0 !important;
    width: 100% !important;
    height: 58px !important;

    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;

    gap: 3px !important;
    padding: 6px 2px !important;

    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;

    color: rgba(255, 255, 255, 0.42) !important;
    font-family: "Barlow", sans-serif !important;

    cursor: pointer !important;
    position: relative !important;

    z-index: 10000 !important;
    transform: none !important;
    pointer-events: auto !important;
  }

  .gh-world__dock button.is-active { color: #24e987 !important; }

  .gh-world__dock > button > span {
    display: block !important;
    width: auto !important;
    height: auto !important;
    margin: 0 !important;
    padding: 0 !important;

    background: transparent !important;
    border-radius: 0 !important;

    font-size: 18px !important;
    line-height: 1 !important;
  }

  .gh-world__dock > button > strong {
    display: block !important;
    margin: 0 !important;
    padding: 0 !important;

    color: inherit !important;

    font: 900 8px/1 "Barlow", sans-serif !important;
    letter-spacing: 0.1em !important;
    text-transform: uppercase !important;

    white-space: nowrap !important;
  }

  .gh-world__dock > button > em {
    position: absolute !important;

    top: 6px !important;
    right: calc(50% - 16px) !important;

    min-width: 14px !important;
    height: 14px !important;

    padding: 0 3px !important;

    display: grid !important;
    place-items: center !important;

    border-radius: 99px !important;

    background: var(--world-gold) !important;
    color: #12120a !important;

    font: 900 8px/1 "Barlow", sans-serif !important;
    font-style: normal !important;
  }

  /* WORLD EVENTS mobile */
  .gh-world-event {
    top: 100px;
    left: 50%;

    max-width: calc(100vw - 24px);

    transform: translateX(-50%) scale(0.85);
    transform-origin: top center;
    z-index: 90;
  }

  .gh-world-profile-backdrop { z-index: 100; }

  .challenge-toasts,
  .gh-challenge-toasts,
  [class*="challenge-toast"] {
    position: fixed !important;

    top: auto !important;
    bottom: 120px !important;
    left: 12px !important;
    right: 12px !important;

    width: auto !important;
    max-width: none !important;

    z-index: 200 !important;

    display: flex !important;
    flex-direction: column !important;
    gap: 8px !important;

    pointer-events: auto !important;
  }

  .challenge-toast,
  [class*="challenge-toast__item"] {
    width: 100% !important;
    max-width: none !important;
    transform: none !important;
  }
}


/* =========================================================
   MOBILE CHICO (<= 420px)
   ========================================================= */

@media (max-width: 420px) {

  .gh-root:has(.gh-world) .gh-tabs { width: 195px; }

  .gh-world__mission {
    top: 88px;
    width: calc(100vw - 24px);
    padding: 7px 10px;
  }

  .gh-world__mission strong { font-size: 16px; }

  .gh-locker-zone {
    top: 152px;
    bottom: 124px;
    width: min(340px, 96vw);
  }

  .gh-locker-zone .avatar2d__character {
    transform: translateX(-50%) scale(0.86);
  }

  .gh-locker-zone .avatar2d__aura {
    width: 300px;
    height: 300px;
    bottom: 30px;
  }

  .gh-locker-zone .locker-equipment .locker-slot {
    width: 60px;
    height: 60px;
  }

  .gh-locker-zone .locker-equipment .locker-slot-icon {
    font-size: 28px !important;
  }

  .gh-locker-zone .locker-equipment .locker-slot:nth-child(1),
  .gh-locker-zone .locker-equipment .locker-slot:nth-child(2) {
    left: 4px;
  }

  .gh-locker-zone .locker-equipment .locker-slot:nth-child(3),
  .gh-locker-zone .locker-equipment .locker-slot:nth-child(4) {
    right: 4px;
  }

  .gh-world__players-toggle {
    left: 10px;
    right: auto;
    bottom: 128px;
  }

  .gh-world__play {
    bottom: 68px;
    width: 180px;
    min-width: 180px;
    height: 40px;
  }

  .gh-world__play strong { font-size: 16px; }

  .gh-world-event {
    top: 92px;
    transform: translateX(-50%) scale(0.8);
  }
}
