}

.gh-world__chat .lc-kicker { display: none; }
.gh-world__chat .lc-title { margin: 0; font-size: 15px; letter-spacing: 0.08em; }
.gh-world__chat .lc-head-right { gap: 6px; }
.gh-world__chat .lc-npc-toggle { display: none; }
.gh-world__chat .lc-status { padding: 3px 8px; font-size: 7px; letter-spacing: 0.1em; }
